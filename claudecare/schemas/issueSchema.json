{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "issue_type", "severity", "action_required", "confidence"
  ],
  "properties": {
    "issue_type": {
      "type": "string",
      "enum": ["billing", "returns", "technical", "other"]
    },
    "issue_type_detail": {
      "type": ["string", "null"],
      "description": "Required when issue_type is 'other'"
    },
    "customer_id": {
      "type": ["string", "null"],
      "description": "C-XXXX format if mentioned, null if absent"
    },
    "severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "action_required": {
      "type": "string",
      "enum": ["refund", "return", "escalate", "investigate", "inform"]
    },
    "amount_pkr": {
      "type": ["number", "null"],
      "description": "PKR amount if mentioned, null if absent"
    },
    "order_id": {
      "type": ["string", "null"],
      "description": "ORD-XXXX format if mentioned, null if absent"
    },
    "invoice_id": {
      "type": ["string", "null"],
      "description": "INV-XXXX format if mentioned, null if absent"
    },
    "escalation_requested": {
      "type": "boolean",
      "description": "true if customer explicitly requested a human agent"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Extraction confidence 0.0-1.0"
    }
  }
}
